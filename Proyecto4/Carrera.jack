/*********
* Carrera.jack - Logica del juego de carriles (seccion 8 del enunciado).
* No puede usar Screen, Output, Keyboard, Grafico ni Sys.wait, ni
* directamente ni a traves de las clases que use.
* Autor: Juan Pablo López
*********/
class Carrera {
    field int meta;
    field int estado;
    field int vidas;
    field int puntaje;
    field int progreso;
    field int carrilCarro;
    field int dirSolicitada;

    field Array obstaculos;
    field int cantidadObstaculos;

    field Array tiposObstaculos;

    /** Nueva carrera: carro en el carril 1, 3 vidas, puntaje 0, progreso 0,
        estado 0 y sin obstaculos. semilla inicializa el generador. */
    constructor Carrera new(int pasosMeta, int semilla) {
        var int i;

        let meta = pasosMeta;
        let estado = 0;
        let dirSolicitada = 0;

        let carrilCarro = 1;
        let vidas = 3;
        let puntaje = 0;
        let progreso = 0;

        let obstaculos = Array.new(20);
        let cantidadObstaculos = 0;

        let tiposObstaculos = Array.new(4);
        let i = 0;
        while (i < 4) {
            let tiposObstaculos[i] = TipoObstaculo.new(i);
            let i = i + 1;
        }

        do Aleatorio.semilla(semilla);
        return this;
    }

    /** Libera los obstaculos, los objetos internos y la carrera. */
    method void dispose() {
        var int i;
        var Obstaculo o;
        var TipoObstaculo t;

        let i = 0;
        while (i < cantidadObstaculos) {
            let o = obstaculos[i];
            do o.dispose();
            let i = i + 1;
        }

        let i = 0;
        while (i < 4) {
            let t =tiposObstaculos[i];
            do t.dispose();
            let i = i + 1;
        }

        do Memory.deAlloc(obstaculos);
        do Memory.deAlloc(tiposObstaculos);
        do Memory.deAlloc(this);
        return;
    }

    /** Solicita un cambio de carril: -1 sube, 1 baja (seccion 8.3). */
    method void moverCarro(int dir) {
        if (estado = 0) {
            if ((dir = -1) | (dir = 1)) {
                let dirSolicitada = dir;
            }
        }
        return;
    }

    /** Agrega un obstaculo del tipo dado con su celda izquierda en col. */
    method void agregarObstaculo(int tipo, int carril, int col) {
        if ((cantidadObstaculos < 20) & TipoObstaculo.tipoValido(tipo)) {
            if ((carril > -1) & (carril < 3)) {
                if ((col > -1) & (col < 32)) {
                    let obstaculos[cantidadObstaculos] = Obstaculo.new(tiposObstaculos[tipo], carril, col);
                    let cantidadObstaculos = cantidadObstaculos + 1;
                }
            }
        }
        return;
    }

    /** Un paso del juego, en el orden de la seccion 8.3. */
    method void avanzar() {
        if (~(estado = 0)) {return;}
        
        do aplicarCambioCarril();
        do moverObstaculos();
        do resolverChoques();

        if (estado = 1) {return;}

        do eliminarFuera();

        let progreso = progreso + 1;
        let puntaje = puntaje + 1;

        if (progreso = meta) {
            let estado = 2;
        }

        return;
    }

    /** Agrega a lo sumo un obstaculo en la columna 31 (seccion 8.4). */
    method void generar() {
        var int x;
        var int lane;
        var int type;
        var TipoObstaculo tipoRef;

        if (~(estado = 0) | (cantidadObstaculos > 19)) {
            return;
        }
        let x = Aleatorio.siguiente();
        if (x < 0) {
            return;
        }
        let lane = buscarCarrilLibre(mod(x / 8, 3));
        if (lane < 0) {
            return;
        }
        let x = Aleatorio.siguiente();
        let type = mod(x / 8, 4);
        let tipoRef = tiposObstaculos[type];
        if (tipoRef.letal() & ~pasoLibreOk(lane)) {
            let type = 3;
        }
        do agregarObstaculo(type, lane, 31);

        return;
    }

    /** Carril del carro: 0, 1 o 2. */
    method int carrilCarro() {
        return carrilCarro;
    }

    /** Tipo del obstaculo que ocupa (carril, col), o -1 si esta libre. */
    method int ocupada(int carril, int col) {
        var int i;
        var Obstaculo o;

        if ((col < 0) | (col > 31)) {
            return -1;
        }
        let i = 0;

        while (i < cantidadObstaculos) {
            let o = obstaculos[i];
            if ((o.carril() = carril) & o.ocupa(col)) {
                return o.tipo();
            }
            let i = i + 1;
        }

        return -1;
    }

    method int vidas() {
        return vidas;
    }

    method int puntaje() {
        return puntaje;
    }

    method int progreso() {
        return progreso;
    }

    /** 0 jugando, 1 derrota, 2 victoria. */
    method int estado() {
        return estado;
    }

    /** Cantidad de obstaculos activos. */
    method int cantidad() {
        return cantidadObstaculos;
    }



    /*  Funciones Helper    */

    /*  Eliminamos los obstaculos que salieron de la pantalla   */
    method void eliminarFuera() {
        var int i;
        var Obstaculo o;

        let i = 0;
        while (i < cantidadObstaculos) {
            let o = obstaculos[i];
            
            if (o.salioCompletamente()) {
                do removerEn(i);
            }
            else {
                let i = i + 1;
            }
        }

        return;
    }

    /*  Resolvemos choques entre el carro y los obstaculos  */
    method void resolverChoques() {
        var int i;
        var Obstaculo o;

        let i = 0;
        while (i < cantidadObstaculos) {
            let o = obstaculos[i];

            if ((o.carril() = carrilCarro) & o.tocaCarro()) {
                if (o.letal()) {
                    let vidas = vidas - 1;
                }
                else {
                    let puntaje = puntaje + o.puntos();
                }

                do removerEn(i);
                if (vidas = 0) {
                    let estado = 1;
                    return;
                }
            }
            else {
                let i = i + 1;
            }
        }

        return;
    }

    /*  Eliminamos el obstaculo en el indice i, y se llena el hueco en el array con el ultimo obstaculo */
    method void removerEn(int i) {
        var Obstaculo o;
        let o = obstaculos[i];
        do o.dispose();

        let cantidadObstaculos = cantidadObstaculos - 1;
        if (i < cantidadObstaculos) {
            let obstaculos[i] = obstaculos[cantidadObstaculos];
        }

        return;
    }

    /*  Avanzamos todos los obstaculos  */
    method void moverObstaculos() {
        var int i;
        var Obstaculo o;

        let i = 0;
        while (i < cantidadObstaculos) {
            let o = obstaculos[i];
            do o.avanzar();
            let i = i + 1;
        }

        return;
    }

    /*  Aplicamos el cambio del carril  */
    method void aplicarCambioCarril() {
        var int nuevo;

        if (~(dirSolicitada = 0)) {
            let nuevo = carrilCarro + dirSolicitada;

            if ((nuevo > -1) & (nuevo < 3)) {
                let carrilCarro = nuevo;
            }
            let dirSolicitada = 0;
        }

        return;
    }

    /*  Buscamos un carril con columna 31 libre empezando desde c   */
    method int buscarCarrilLibre(int c) {
        var int intentos;
        var int lane;

        let lane = c;
        let intentos = 0;
        while (intentos < 3) {
            if (ocupada(lane, 31) < 0) {
                return lane;
            }
            let lane = lane + 1;
            if (lane > 2) {
                let lane = 0;
            }
            let intentos = intentos + 1;
        }

        return -1;
    }

    /*  Revisamos si en el carril c podemos añadir un obstaculo letal   */
    method boolean pasoLibreOk(int c) {
        var int o1;
        var int o2;

        if (c = 0) {let o1 = 1; let o2 = 2;}
        if (c = 1) {let o1 = 0; let o2 = 2;}
        if (c = 2) {let o1 = 0; let o2 = 1;}

        if (letalEnRango(o1) & letalEnRango(o2)) {
            return false;
        }

        return true;
    }

    /*  Verificamos si hay un obstaculo letal en las columnas 26 a 31   */
    method boolean letalEnRango(int c) {
        var int col;
        var int t;
        var TipoObstaculo tipoRef;

        let col = 26;
        while (col < 32) {
            let t = ocupada(c, col);
            if (t > -1) {
                let tipoRef = tiposObstaculos[t];
                if (tipoRef.letal()) {
                    return true;
                }
            }
            let col = col + 1;
        }
        return false;
    }

    /*  x mod n */
    method int mod(int x, int n) {
        var int m;
        let m = x - (n * (x / n));

        if (m < 0) {
            let m = m + n;
        }

        return m;
    }
}
