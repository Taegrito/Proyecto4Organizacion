    /*
    Crea el sprite de la moneda y retorna el arreglo de su representación gráfica.
    */
    method Array crearSpriteMoneda() {
        var Array s;
        let s = Array.new(16);

        let s[0] = 0;
        let s[1] = 768;
        let s[2] = 1920;
        let s[3] = 4032;
        let s[4] = 8184;
        let s[5] = 16368;
        let s[6] = 16368;
        let s[7] = 16368;
        let s[8] = 16368;
