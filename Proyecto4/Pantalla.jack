/**Archivo: Pantalla.jack
Descripción: Se encarga de manejar la interfaz del juego de carreras.
Responsabilidades: Mostrar los elementos y dibujar los elementos del juego (camiones,monedas,carriles,carro,etc)
Autor: Ana Isabella Gómez García
**/

class Pantalla{
    field boolean salir;
    field boolean pausado;
    field int distancia;
    field boolean reiniciar;
    field Array spriteCarro;
    field Array spriteCono;
    field Array spriteMoto;
    field Array spriteMoneda;
    field Array spriteCamionIzq;
    field Array spriteCamionCentro;
    field Array spriteCamionDer;

    /*
    Inicializa la pantalla y todos sus atributos, establece sus valores y crea los sprites para dibujar los elementos
    */
    constructor Pantalla new() {
        let salir=false;
        let pausado=false;
        let distancia=50;
        let reiniciar=false;

        let spriteCarro = crearSpriteCarro();
        let spriteCono = crearSpriteCono();
        let spriteCamionIzq = crearSpriteCamionIzq();
        let spriteCamionCentro = crearSpriteCamionCentro();
        let spriteCamionDer = crearSpriteCamionDer();
        let spriteMoto = crearSpriteMoto();
        let spriteMoneda = crearSpriteMoneda();
        
        return this;
    }

    /*
    Muestra el menú inicialy permite iniciar nuevas partidas hasta que el usuario decida salir
    */
    method void ejecutar() {
        while (~salir){
            let distancia=menuInicial();
            if (~salir){
                do jugar(distancia);
            }
        }
        return;
    }

    /*
    Crea el arreglo que representa el sprite del carro jugador y retorna el arreglo con los dibujos.
    */
    method Array crearSpriteCarro() {
        var Array s;
        let s = Array.new(16);

        let s[0] = 0;
        let s[1] = 768;
        let s[2] = 1920;
        let s[3] = 4032;
        let s[4] = 8184;
        let s[5] = 16368;
        let s[6] = 16368;
        let s[7] = 16368;
        let s[8] = 16368;
        let s[9] = 16368;
        let s[10] = 8184;
        let s[11] = 4032;
        let s[12] = 1920;
        let s[13] = 768;
        let s[14] = 0;
        let s[15] = 0;

        return s;
    }

    /*
    Crea el arreglo que representa el sprite del cono con un arreglo de 16 valores y retorna los datos de dibujo
    */
    method Array crearSpriteCono() {
        var Array s;
        let s = Array.new(16);

        let s[0] = 0;
        let s[1] = 256;
        let s[2] = 768;
        let s[3] = 1792;
        let s[4] = 3840;
        let s[5] = 3840;
        let s[6] = 7680;
        let s[7] = 7680;
        let s[8] = 15360;
        let s[9] = 15360;
        let s[10] = 15360;
        let s[11] = 15360;
        let s[12] = 15360;
        let s[13] = 15360;
        let s[14] = 0;
        let s[15] = 0;

        return s;
    }

    /*
    Construye la parte izquierda del camión 
    */
