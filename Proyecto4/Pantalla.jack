    /*
    Crea el sprite de la moto, utilizando un arreglo de 16 valores para crear la gráfica del elemento.
    */
    method Array crearSpriteMoto() {
        var Array s;
        let s = Array.new(16);

        let s[0] = 0;
        let s[1] = 0;
        let s[2] = 768;
        let s[3] = 1920;
        let s[4] = 4032;
        let s[5] = 8160;
        let s[6] = 16368;
        let s[7] = 8184;
        let s[8] = 4080;
        let s[9] = 2016;
        let s[10] = 960;
        let s[11] = 480;
